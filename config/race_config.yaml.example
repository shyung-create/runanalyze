# Template only — this file is tracked in git and never read by the pipeline.
# On first setup, copy it to config/race_config.yaml (gitignored, not tracked)
# and edit THAT file — either by hand or via the dashboard's Admin tab, which
# writes to it directly. Never edit config/race_config.yaml.example itself
# expecting it to take effect.
race:
  name: "SF Marathon"              # target race name
  distance_type: "full"     # "half" or "full"
  race_date: "2026-07-26"         # YYYY-MM-DD
  target_time: "04:00:00"       # HH:MM:SS goal finish time

# Athlete / pipeline preferences
preferences:
  units: "km"           # "miles" or "km" — must match your GarminDB measurement setting
  long_run_day: "sunday"   # weekly long run lands here (swapped within the week)
  rest_days: []         # weekdays that are ALWAYS rest, e.g. [friday, monday] —
  #                     # the displaced workout swaps to a rest day in the same week
  blocked_dates: []     # one-off no-run dates, e.g. [2026-07-22]
  max_run_days_per_week: 5
  activities_since: "2024-06-01"  # ignore any activity before this date
  #                     # (YYYY-MM-DD). Leave "" to use full history.
  # plan_id: ""         # optional — force a specific program instead of
  #                     # auto-selection. Valid ids (see pipeline/plans_catalog.json):
  #                     # full: marathon_higdon_novice_1, marathon_higdon_novice_2,
  #                     #   marathon_higdon_intermediate_1, marathon_higdon_intermediate_2,
  #                     #   marathon_higdon_advanced_1, marathon_higdon_advanced_2,
  #                     #   marathon_hansons_beginner, marathon_hansons_advanced,
  #                     #   marathon_pfitzinger_12_55/12_70/12_85/18_55/18_70/18_85
  #                     # half: half_hansons_beginner, half_hansons_advanced,
  #                     #   half_pfitzinger_12_63, half_pfitzinger_12_84
