# Deployment .env template — copy to <APP_DIR>/.env, chmod 600, fill in by
# hand. Placeholders only; nothing here is a real secret.
#
# Var names below are the exact ones webapp/config.py and pipeline/*.py
# read (confirmed by reading the code, not assumed) — a renamed var here
# would silently read as empty rather than error, which for
# DASHBOARD_PASSWORD_HASH means nobody can log in, and for
# SESSION_SECRET_KEY means sessions reset on every process restart.
#
# No GARMIN_PASSWORD var, and there never will be one: the Garmin
# credential lives only in ~/.GarminDb/GarminConnectConfig.json — see
# deploy/GarminConnectConfig.example.json. Nothing reads a Garmin
# password from the environment anywhere in this codebase.

# --- DeepSeek API (OpenAI-compatible) ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=

# --- GarminDB ---
GARMINDB_DIR=~/HealthData/DBs
GARMINDB_CLI=garmindb_cli.py
# GARMINDB_UNITS=km

# --- Web dashboard login ---
DASHBOARD_USER=admin
# argon2id hash, NEVER the plaintext password. Generate on the instance:
#   .venv/bin/python webapp/scripts/hash_password.py
DASHBOARD_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$c2FsdHNhbHRzYWx0$aGFzaGhhc2hoYXNoaGFzaGhhc2g

# Signs session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Dev-only escape hatch — relaxes the session cookie's Secure flag for
# local http testing. Never set this in the deployed .env: this app only
# ever runs behind Tailscale's HTTPS (`tailscale serve`) in production.
# WEBAPP_COOKIE_INSECURE=1

# --- Telegram failure alerts (reused acuity pattern) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
