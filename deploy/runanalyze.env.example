# Deployment .env template — copy to <APP_DIR>/.env, chmod 600, fill in by
# hand. Placeholders only; nothing here is a real secret.
#
# Var names below are the exact ones webapp/config.py and pipeline/*.py
# read (confirmed by reading the code, not assumed) — a renamed var here
# would silently read as empty rather than error, e.g. SESSION_SECRET_KEY
# means the CSRF cookie's signing key resets on every process restart.
#
# No GARMIN_PASSWORD var, and there never will be one: the Garmin
# credential lives only in ~/.GarminDb/GarminConnectConfig.json — see
# deploy/GarminConnectConfig.example.json. Nothing reads a Garmin
# password from the environment anywhere in this codebase.
#
# No dashboard login exists either — Tailscale's tailnet-only reachability
# (`tailscale serve`) is the access control. See webapp/auth.py's module
# docstring for the tradeoff this accepts before changing it back.

# --- DeepSeek API (OpenAI-compatible) ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=

# --- Claude API (alternative provider — switch via preferences.llm_provider
# in race_config.yaml / the Admin tab, not an env var) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- GarminDB ---
GARMINDB_DIR=~/HealthData/DBs
GARMINDB_CLI=garmindb_cli.py
# GARMINDB_UNITS=km

# Signs the CSRF cookie (not a login session — there isn't one). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Dev-only escape hatch — relaxes the CSRF cookie's Secure flag for local
# http testing. Never set this in the deployed .env: this app only ever
# runs behind Tailscale's HTTPS (`tailscale serve`) in production.
# WEBAPP_COOKIE_INSECURE=1

# --- Telegram failure alerts (reused acuity pattern) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
