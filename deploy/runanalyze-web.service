[Unit]
Description=runanalyze web dashboard
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=runanalyze
Group=runanalyze
WorkingDirectory=/home/runanalyze/runanalyze
EnvironmentFile=/home/runanalyze/runanalyze/.env
ExecStart=/home/runanalyze/runanalyze/.venv/bin/uvicorn webapp.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10

# Binds to loopback only (see ExecStart --host). Reachability comes from
# `tailscale serve` proxying https://<tailnet-name>/ -> 127.0.0.1:8000 —
# this unit never touches the tailscale0 interface directly.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=yes would hide the service user's own home entirely, which
# is where the repo/venv/credential file/var dir all live — incompatible
# with this service. ProtectHome=tmpfs + BindPaths is the tighter
# alternative to ProtectHome=no: it mounts an EMPTY tmpfs over /home for
# this unit's namespace, then punches through only the paths listed below.
# Anything else under /home (including other accounts' homes, or stray
# files in this account's own home outside these paths) stays invisible.
ProtectHome=tmpfs
BindPaths=/home/runanalyze/runanalyze /home/runanalyze/.GarminDb /home/runanalyze/HealthData /home/runanalyze/.ssh
# HealthData IS needed here, despite no HTTP route ever reading it
# directly (that guarantee is unchanged — see webapp/main.py's
# _safe_file/_reject_forbidden_suffix). /api/refresh spawns
# pipeline/refresh.py as a child process (webapp/jobs.py), which inherits
# this unit's mount namespace and runs the exact same code as the
# scheduled timer job — garmin_extract.extract_runs() reads GarminDB's
# SQLite files from HealthData/DBs, and a fresh sync writes them there.
# Found live: a "reanalyze only" (--no-sync) refresh triggered from the
# dashboard failed with FileNotFoundError on garmin_activities.db because
# this bind was missing — the child process literally couldn't see the
# directory under ProtectHome=tmpfs's empty overlay.
# .ssh is needed for the same reason, one layer further in: git_publish()'s
# `git push` over the SSH deploy key remote needs both the private key and
# known_hosts, which live directly under ~/.ssh — found live, "Host key
# verification failed" (known_hosts invisible) after already fixing the
# repo-local git identity and switching the remote off HTTPS. Same blind
# spot as ~/.gitconfig: anything living directly under the home root,
# rather than one of the subdirectories already listed here, is invisible
# under ProtectHome=tmpfs until explicitly bound.
# Same finding as runanalyze.service: default process umask leaves new
# files/dirs group/world-readable (this unit writes GarminConnectConfig.json
# via webapp/garmin_config.py's atomic write, which already chmods 0600
# explicitly -- but UMask here is defense in depth for anything else this
# process or a future route ever creates).
UMask=0077

[Install]
WantedBy=multi-user.target
