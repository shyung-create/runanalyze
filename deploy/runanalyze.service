[Unit]
Description=runanalyze nightly refresh
OnFailure=runanalyze-notify-failure@%n.service

[Service]
Type=oneshot
User=runanalyze
Group=runanalyze
WorkingDirectory=/home/runanalyze/runanalyze
EnvironmentFile=/home/runanalyze/runanalyze/.env
# --push is mandatory for any unattended run — without it, git_publish()
# hits an input() prompt that raises EOFError under systemd (no tty) and
# silently never pushes. See pipeline/refresh.py's git_publish().
ExecStart=/home/runanalyze/runanalyze/.venv/bin/python pipeline/refresh.py --push

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
# Adds HealthData on top of the web unit's set — garmindb_cli.py writes
# its SQLite databases there. .ssh holds the deploy key + known_hosts that
# git_publish()'s `git push` needs (SSH remote, not HTTPS) — found live via
# the same "Host key verification failed" failure mode as the web unit;
# this unit was never actually exercised end-to-end before that fix, so
# it would have failed identically on its first scheduled run tonight.
BindPaths=/home/runanalyze/runanalyze /home/runanalyze/.GarminDb /home/runanalyze/HealthData /home/runanalyze/.ssh
# Found live: garmindb_cli.py (and the DB library underneath it) create
# files/dirs using whatever the process umask allows -- they have no idea
# about this project's 0600/0700 model. Default umask left the token
# cache at 664 and the whole HealthData tree at 775/644. UMask here
# applies to every file this unit or anything it execs ever creates, not
# just a one-time chmod on what exists today.
UMask=0077
