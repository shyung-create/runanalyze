# Copy to .env and fill in. NEVER commit .env.

# DeepSeek API (OpenAI-compatible). Only used by the local pipeline;
# the published site never sees this key.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Chat model used for plan revision / analysis (DeepSeek V4 chat)
DEEPSEEK_MODEL=deepseek-chat
# Vision-capable model to read the course elevation screenshot.
# Leave blank if your plan tier has no vision model — the pipeline will
# fall back to config/course_segments.yaml.
DEEPSEEK_VISION_MODEL=

# Claude API — alternative LLM provider, selected via preferences.llm_provider
# in race_config.yaml (Admin tab's Race details panel), not an env var. No
# separate vision-model var needed — Claude's main models are natively
# multimodal.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Where GarminDB keeps its SQLite databases (default shown)
GARMINDB_DIR=~/HealthData/DBs

# Units GarminDB itself stores distances in (independent of
# race_config.yaml's preferences.units, which only controls dashboard
# display). Auto-detected from ~/.GarminDb/GarminConnectConfig.json's
# settings.metric — only set this if that detection is wrong or the file
# lives elsewhere. Values: km or miles.
# GARMINDB_UNITS=km

# Path to garmindb_cli.py if it is not on your PATH. refresh.py always
# launches it via the current Python interpreter, so a plain .py path works
# on Windows too — no need to prefix it with "python".
# Windows example (adjust the Python version folder to yours):
# GARMINDB_CLI=C:\Users\you\AppData\Local\Python\pythoncore-3.12-64\Scripts\garmindb_cli.py
GARMINDB_CLI=garmindb_cli.py

# --- Web dashboard (webapp/) ---
# No login — Tailscale's tailnet-only reachability (`tailscale serve`) is
# the access control. See webapp/auth.py's module docstring for the
# tradeoff this accepts.

# Random secret used to sign the CSRF cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Only set this to relax the CSRF cookie's Secure flag for local http
# development. Never set it in production — this app only ever runs
# behind Tailscale's HTTPS (`tailscale serve`) in deployment.
# WEBAPP_COOKIE_INSECURE=1

# --- Telegram failure alerts (reused pattern from the acuity project) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
